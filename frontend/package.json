{
  "name": "nafi-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm --prefix .. run dev --workspace=@nafi/web",
    "build": "npm --prefix .. run build --workspace=@nafi/web",
    "lint": "npm --prefix .. run lint --workspace=@nafi/web",
    "typecheck": "npm --prefix .. exec --workspace=@nafi/web -- tsc --noEmit",
    "test": "npm --prefix .. run test --workspace=@nafi/web",
    "test:coverage": "npm --prefix .. run test:coverage --workspace=@nafi/web",
    "test:e2e": "npm --prefix .. test --workspace=@nafi/e2e",
    "test:e2e:ui": "npm --prefix .. run test:ui --workspace=@nafi/e2e",
    "test:a11y": "npm --prefix .. run test:a11y --workspace=@nafi/e2e",
    "lighthouse": "lhci autorun",
    "size": "size-limit",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "clean": "npm --prefix .. run clean --workspace=@nafi/web",
    "storybook": "npm --prefix .. run storybook --workspace=@nafi/ui-react",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@lhci/cli": "^0.14.0",
    "@nafi/config": "*",
    "@size-limit/preset-app": "^11.1.4",
    "@types/node": "^22.7.5",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "size-limit": "^11.1.4",
    "turbo": "^2.2.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
