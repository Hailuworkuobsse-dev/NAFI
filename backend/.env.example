NODE_ENV=development
PORT=3000

# Database (MySQL)
DATABASE_URL=mysql://root:admin@localhost:3307/nafi_db?schema=public

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Logging
LOG_LEVEL=info
REDACT_FIELDS=password,token,secret,apiKey

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Helmet CSP
HELMET_CSP_DIRECTIVES=
