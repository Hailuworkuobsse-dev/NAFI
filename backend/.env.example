NODE_ENV=development
PORT=3143

# Database
DATABASE_URL=mysql://root:admin@localhost:3307/nafiDB

# JWT (generate with: openssl rand -base64 48)
JWT_SECRET=replace-with-64-char-random-string
JWT_REFRESH_SECRET=replace-with-another-64-char-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3144

# Cookies
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
